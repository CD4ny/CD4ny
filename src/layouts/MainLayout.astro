---
import BaseHead from "../components/BaseHead.astro";
import { SiteConfigController } from "../presentation/controllers/SiteConfigController";
import { SiteConfigViewModelMapper } from "../presentation/viewmodels/SiteConfigViewModel";

// Dependency Injection - Controller
const siteConfigController = new SiteConfigController();
const siteConfig = await siteConfigController.getSiteConfig();
const siteConfigViewModel = SiteConfigViewModelMapper.toViewModel(siteConfig);
---
<html lang="en">
<BaseHead title={siteConfigViewModel.title} description={siteConfigViewModel.description}></BaseHead>
<body class="bg-primary dark:bg-dark">
<main>
    <slot/>
</main>
</body>
</html>
